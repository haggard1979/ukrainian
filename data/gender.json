{
  "rules": {
    "mc": {
      "title": {"de":"Konsonant am Ende","en":"Consonant at the end"},
      "text": {
        "de": "Nomen, die auf einen Konsonanten enden, sind meist maskulin: стіл, брат, телефон.",
        "en": "Nouns ending in a consonant are usually masculine: стіл, брат, телефон."
      }
    },
    "mj": {
      "title": {"de":"Endung -й","en":"Ending -й"},
      "text": {
        "de": "Nomen auf -й sind maskulin: музей, чай, трамвай.",
        "en": "Nouns in -й are masculine: музей, чай, трамвай."
      }
    },
    "ms": {
      "title": {"de":"Maskulin auf -ь","en":"Masculine in -ь"},
      "text": {
        "de": "Auf -ь gibt es maskuline und feminine Nomen – dieses ist maskulin: день, учитель, кінь.",
        "en": "Nouns in -ь can be masculine or feminine – this one is masculine: день, учитель, кінь."
      }
    },
    "mx": {
      "title": {"de":"Maskulin trotz -о / -а","en":"Masculine despite -о / -а"},
      "text": {
        "de": "Männliche Personen und einige Tiere auf -о oder -а sind maskulin: батько, тато, собака.",
        "en": "Male persons and some animals in -о or -а are masculine: батько, тато, собака."
      }
    },
    "fa": {
      "title": {"de":"Endung -а","en":"Ending -а"},
      "text": {
        "de": "Nomen auf -а sind meist feminin: книга, мама, вода.",
        "en": "Nouns in -а are usually feminine: книга, мама, вода."
      }
    },
    "fy": {
      "title": {"de":"Endung -я","en":"Ending -я"},
      "text": {
        "de": "Nomen auf -я (auch -ія) sind meist feminin: земля, кухня, станція.",
        "en": "Nouns in -я (also -ія) are usually feminine: земля, кухня, станція."
      }
    },
    "fs": {
      "title": {"de":"Feminin ohne Endung","en":"Feminine without an ending"},
      "text": {
        "de": "Einige feminine Nomen enden auf -ь oder einen Konsonanten: ніч, сіль, любов, подорож. Am besten mit dem Genus lernen.",
        "en": "Some feminine nouns end in -ь or a consonant: ніч, сіль, любов, подорож. Best learnt together with the gender."
      }
    },
    "fi": {
      "title": {"de":"Endung -ість","en":"Ending -ість"},
      "text": {
        "de": "Nomen auf -ість sind feminin: радість, швидкість. Ausnahme: гість (maskulin).",
        "en": "Nouns in -ість are feminine: радість, швидкість. Exception: гість (masculine)."
      }
    },
    "no": {
      "title": {"de":"Endung -о","en":"Ending -о"},
      "text": {
        "de": "Nomen auf -о sind neutral: вікно, місто, молоко.",
        "en": "Nouns in -о are neuter: вікно, місто, молоко."
      }
    },
    "ne": {
      "title": {"de":"Endung -е","en":"Ending -е"},
      "text": {
        "de": "Nomen auf -е sind neutral: море, сонце, серце.",
        "en": "Nouns in -е are neuter: море, сонце, серце."
      }
    },
    "ny": {
      "title": {"de":"-я nach Doppelkonsonant","en":"-я after a double consonant"},
      "text": {
        "de": "Nomen auf -ння, -ття, -лля, -сся … sind neutral: життя, завдання, весілля.",
        "en": "Nouns in -ння, -ття, -лля, -сся … are neuter: життя, завдання, весілля."
      }
    },
    "nj": {
      "title": {"de":"Tierjunge","en":"Young animals"},
      "text": {
        "de": "Bezeichnungen für Tierjunge auf -я / -а sind neutral: кошеня, теля, курча.",
        "en": "Words for young animals in -я / -а are neuter: кошеня, теля, курча."
      }
    },
    "nf": {
      "title": {"de":"Unveränderliche Fremdwörter","en":"Indeclinable loanwords"},
      "text": {
        "de": "Fremdwörter auf -е, -о, -і, -ю, die nicht dekliniert werden, sind meist neutral: кафе, метро, таксі, меню.",
        "en": "Loanwords in -е, -о, -і, -ю that do not decline are usually neuter: кафе, метро, таксі, меню."
      }
    },
    "pt": {
      "title": {"de":"Nur Plural","en":"Plural only"},
      "text": {
        "de": "Diese Nomen gibt es nur im Plural; Adjektive stehen im Plural: нові двері, мої гроші.",
        "en": "These nouns exist only in the plural; adjectives take the plural: нові двері, мої гроші."
      }
    },
    "ah": {
      "title": {"de":"Adjektiv, harter Stamm","en":"Adjective, hard stem"},
      "text": {
        "de": "Endungen -ий (m.), -а (f.), -е (n.), -і (Pl.): новий, нова, нове, нові.",
        "en": "Endings -ий (m.), -а (f.), -е (n.), -і (pl.): новий, нова, нове, нові."
      }
    },
    "as": {
      "title": {"de":"Adjektiv, weicher Stamm","en":"Adjective, soft stem"},
      "text": {
        "de": "Endungen -ій (m.), -я (f.), -є (n.), -і (Pl.): синій, синя, синє, сині.",
        "en": "Endings -ій (m.), -я (f.), -є (n.), -і (pl.): синій, синя, синє, сині."
      }
    },
    "pd": {
      "title": {"de":"Pronomen","en":"Pronouns"},
      "text": {
        "de": "Possessiv- und Demonstrativpronomen haben eigene Formen: мій / моя / моє / мої, цей / ця / це / ці, той / та / те / ті.",
        "en": "Possessive and demonstrative pronouns have their own forms: мій / моя / моє / мої, цей / ця / це / ці, той / та / те / ті."
      }
    }
  },

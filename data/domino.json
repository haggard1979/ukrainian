      "uk": "Давальний",
      "preps": ["завдяки","всупереч"],
      "note": {
        "de": "Nach завдяки („dank“) und всупереч („entgegen“) steht immer der Dativ.",
        "en": "After завдяки (“thanks to”) and всупереч (“contrary to”) the dative is always used."
      }
    }

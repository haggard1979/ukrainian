      "name": {"de":"Lokativ","en":"Locative"},
      "uk": "Місцевий",
      "preps": ["при"],
      "note": {
        "de": "Nach при („bei, an“) steht immer der Lokativ.",
        "en": "After при (“at, attached to”) the locative is always used."

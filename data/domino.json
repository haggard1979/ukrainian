      "uk": "Знахідний",
      "preps": ["про","через"],
      "note": {
        "de": "Nach про („über“) und через („durch, über“) steht immer der Akkusativ.",
        "en": "After про (“about”) and через (“through, across”) the accusative is always used."
      }
    },
    {
      "id": "ins",
      "name": {"de":"Instrumental","en":"Instrumental"},
      "uk": "Орудний",
      "preps": ["над","перед"],
      "note": {
        "de": "Nach над („über“) und перед („vor“) steht immer der Instrumental.",

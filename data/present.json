{
  "rules": {
    "c1v": {
      "title": {"de":"I. Konjugation, Vokalstamm","en":"1st conjugation, vowel stem"},
      "text": {
        "de": "Endungen -ю, -єш, -є, -ємо, -єте, -ють. Dazu gehören die meisten Verben auf -ати/-яти und alle auf -увати/-ювати.",
        "en": "Endings -ю, -єш, -є, -ємо, -єте, -ють. Most verbs in -ати/-яти and all verbs in -увати/-ювати belong here."
      }
    },
    "c1c": {
      "title": {"de":"I. Konjugation, Konsonantstamm","en":"1st conjugation, consonant stem"},
      "text": {
        "de": "Endungen -у, -еш, -е, -емо, -ете, -уть. Der Stamm verändert sich oft: писати → пишу, жити → живу.",
        "en": "Endings -у, -еш, -е, -емо, -ете, -уть. The stem often changes: писати → пишу, жити → живу."
      }
    },
    "c2": {
      "title": {"de":"II. Konjugation","en":"2nd conjugation"},
      "text": {
        "de": "Endungen -ю/-у, -иш, -ить, -имо, -ите, -ять/-ать. In der я-Form ändert sich oft der Konsonant: ходити → ходжу, робити → роблю.",
        "en": "Endings -ю/-у, -иш, -ить, -имо, -ите, -ять/-ать. The consonant often changes in the я form: ходити → ходжу, робити → роблю."
      }
    },
    "refl": {
      "title": {"de":"Reflexive Verben","en":"Reflexive verbs"},
      "text": {
        "de": "Konjugiert wie das Grundverb, danach -ся. Nach Vokal auch -сь: вчуся / вчусь.",
        "en": "Conjugated like the base verb, followed by -ся. After a vowel also -сь: вчуся / вчусь."
      }
    },
    "irr": {
      "title": {"de":"Besondere Verben","en":"Special verbs"},
      "text": {
        "de": "Veränderter Stamm oder eigene Endungen; am besten als ganze Tabelle lernen.",
        "en": "A changed stem or endings of their own; best learnt as a whole table."
      }
    }
  },
  "categories": [
    {"id":"c1","label":{"de":"I. Konjugation","en":"1st conjugation"}},
    {"id":"c2","label":{"de":"II. Konjugation","en":"2nd conjugation"}},
    {"id":"refl","label":{"de":"Reflexiv","en":"Reflexive"}},
    {"id":"irr","label":{"de":"Besondere Verben","en":"Special verbs"}}

{
  "rules": {
    "reg": {
      "title": {"de":"Regelmäßige Bildung","en":"Regular formation"},
      "text": {
        "de": "Infinitiv ohne -ти, dann -в (m), -ла (f), -ло (n), -ли (Pl).",
        "en": "Infinitive without -ти, then -в (m), -ла (f), -ло (n), -ли (pl)."
      }
    },
    "cons": {
      "title": {"de":"Stamm auf Konsonant","en":"Consonant stem"},
      "text": {
        "de": "Im Maskulinum kein -в, und е/о/я werden dort oft zu і: ніс, несла; міг, могла.",
        "en": "No -в in the masculine, where е/о/я often become і: ніс, несла; міг, могла."
      }
    },
    "refl": {
      "title": {"de":"Reflexive Verben","en":"Reflexive verbs"},
      "text": {
        "de": "Form ohne -ся bilden, dann -ся: -вся, -лася, -лося, -лися. Nach Vokal auch -сь.",
        "en": "Form the verb without -ся, then add -ся: -вся, -лася, -лося, -лися. After a vowel also -сь."
      }
    },
    "irr": {
      "title": {"de":"Besondere Verben","en":"Special verbs"},
      "text": {
        "de": "Eigener Stamm (іти → йшов) oder -сти fällt ganz weg (їсти → їв).",
        "en": "A stem of their own (іти → йшов), or -сти is dropped entirely (їсти → їв)."
      }
    }
  },
  "categories": [
    {"id":"reg","label":{"de":"Regelmäßig","en":"Regular"}},
    {"id":"cons","label":{"de":"Konsonantstamm","en":"Consonant stem"}},
    {"id":"refl","label":{"de":"Reflexiv","en":"Reflexive"}},
    {"id":"irr","label":{"de":"Besondere Verben","en":"Special verbs"}}
  ],
